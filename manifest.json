{
  "manifest_version": 3,
  "name": "DeepSeek 智能解释",
  "version": "1.0.0",
  "description": "选中文本，DeepSeek 立刻为你解释——英文给英文释义，中文给中文解读，浮窗即显即消。",
  "permissions": ["storage", "downloads", "contextMenus"],
  "host_permissions": [
    "<all_urls>",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_title": "DeepSeek 智能解释",
    "default_popup": "popup.html"
  }
}
